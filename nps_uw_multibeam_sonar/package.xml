<?xml version="1.0"?>
<package format="3">

  <name>nps_uw_multibeam_sonar</name>
  <version>0.0.1</version>

  <description>
    NPS Multibeam Sonar Plugin with NVIDIA CUDA library
  </description>

  <maintainer email="woensug.choi.ks@nps.edu">
    Woensug Choi
  </maintainer>

  <author email="woensug.choi.ks@nps.edu">
    Woensug Choi
  </author>

  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- TF2 -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Gazebo Harmonic -->
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_interfaces</depend>

  <!-- Vision -->
  <depend>cv_bridge</depend>

  <!-- PointCloud -->
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>

  <!-- Acoustic messages -->
  <depend>marine_acoustic_msgs</depend>

  <!-- Utility -->
  <depend>xacro</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
