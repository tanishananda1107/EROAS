<?xml version="1.0"?>
<package format="3">

  <name>uuv_tutorial_rov_model</name>
  <version>0.5.2</version>

  <description>
    Template package for the construction of a new thruster actuated
    UUV model for ROS 2 and Gazebo Harmonic / GZ Sim 8.
  </description>

  <!-- Maintainers -->
  <maintainer email="musa.marcusso@de.bosch.com">
    Musa Morena Marcusso Manhaes
  </maintainer>

  <maintainer email="sebastian.scherer2@de.bosch.com">
    Sebastian Scherer
  </maintainer>

  <maintainer email="luizricardo.douat@de.bosch.com">
    Luiz Ricardo Douat
  </maintainer>

  <!-- Authors -->
  <author email="musa.marcusso@de.bosch.com">
    Musa Morena Marcusso Manhaes
  </author>

  <author email="sebastian.scherer2@de.bosch.com">
    Sebastian Scherer
  </author>

  <author email="luizricardo.douat@de.bosch.com">
    Luiz Ricardo Douat
  </author>

  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>

  <!-- Gazebo Harmonic / GZ Sim -->
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <!-- Launch system -->
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
