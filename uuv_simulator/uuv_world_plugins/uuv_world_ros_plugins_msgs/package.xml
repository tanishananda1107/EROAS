<?xml version="1.0"?>
<package format="3">

  <name>uuv_world_ros_plugins_msgs</name>
  <version>0.6.13</version>

  <description>
    ROS2 service definitions for UUV world ROS plugins
  </description>

  <!-- Maintainers -->

  <maintainer email="musa.marcusso@de.bosch.com">
    Musa Morena Marcusso Manhaes
  </maintainer>

  <maintainer email="sebastian.scherer2@de.bosch.com">
    Sebastian Scherer
  </maintainer>

  <maintainer email="luizricardo.douat@de.bosch.com">
    Luiz Ricardo Douat
  </maintainer>

  <!-- Authors -->

  <author email="musa.marcusso@de.bosch.com">
    Musa Morena Marcusso Manhaes
  </author>

  <author email="sebastian.scherer2@de.bosch.com">
    Sebastian Scherer
  </author>

  <author email="luizricardo.douat@de.bosch.com">
    Luiz Ricardo Douat
  </author>

  <!-- License -->

  <license>Apache-2.0</license>

  <!-- Build tool -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 interface generation -->

  <build_depend>rosidl_default_generators</build_depend>

  <!-- Runtime -->

  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Dependencies -->

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Required for interface packages -->

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
