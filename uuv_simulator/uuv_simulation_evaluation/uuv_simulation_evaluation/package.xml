<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uuv_simulation_evaluation</name>
  <version>0.6.13</version>
  <description>Package containing Python libraries for ROS bag evaluation and cost function computation</description>

  <maintainer email="musa.marcusso@de.bosch.com">Musa Morena Marcusso Manhaes</maintainer>

  <license>Apache-2.0</license>

  <author email="musa.marcusso@de.bosch.com">Musa Morena Marcusso Manhaes</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2cli</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>uuv_trajectory_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
