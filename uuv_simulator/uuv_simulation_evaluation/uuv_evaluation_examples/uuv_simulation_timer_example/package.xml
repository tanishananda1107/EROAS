<?xml version="1.0"?>
<package format="3">

  <name>uuv_simulation_timer_example</name>
  <version>1.0.0</version>

  <description>
    ROS 2 simulation timer example for Gazebo Harmonic / GZ Sim 8
  </description>

  <maintainer email="musa.marcusso@de.bosch.com">
    Musa Morena Marcusso Manhaes
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Gazebo Harmonic -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- UUV dependencies -->
  <exec_depend>uuv_descriptions</exec_depend>
  <exec_depend>uuv_simulation_wrapper</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
