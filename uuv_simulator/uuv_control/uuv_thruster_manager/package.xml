<?xml version="1.0"?>
<package format="3">

  <name>uuv_thruster_manager</name>
  <version>0.6.13</version>

  <description>ROS2 thruster manager package</description>

  <maintainer email="musa.marcusso@de.bosch.com">
    Musa Morena Marcusso Manhaes
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>

  <depend>rclpy</depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <depend>tf2_ros</depend>
  <depend>tf_transformations</depend>

  <depend>uuv_gazebo_ros_plugins_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <test_depend>joint_state_publisher</test_depend>
  <test_depend>robot_state_publisher</test_depend>

  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
