<?xml version="1.0"?>
<sdf version="1.10">
  <model name="rexrov2">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>1862.87</mass>
        <inertia>
          <ixx>525.39</ixx>
          <iyy>794.20</iyy>
          <izz>691.23</izz>
          <ixy>1.44</ixy>
          <ixz>33.41</ixz>
          <iyz>2.60</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>4.2 2.1 1.8</size>
          </box>
        </geometry>
      </collision>
      <visual name="rexrov2_mesh">
        <geometry>
          <mesh>
            <uri>model://rexrov2_description/meshes/RexROV2_no_props.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="rexrov2_visible_body">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>4.2 2.1 1.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.10 1</ambient>
          <diffuse>1.0 0.92 0.15 1</diffuse>
          <specular>0.1 0.1 0.05 1</specular>
        </material>
      </visual>
      <visual name="rexrov2_visible_nose">
        <pose>2.35 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.65</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.0 0.85 1.0 1</ambient>
          <diffuse>0.0 0.85 1.0 1</diffuse>
        </material>
      </visual>
      <visual name="rexrov2_visible_top">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry>
          <box>
            <size>2.2 1.1 0.28</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.20 0.30 1</ambient>
          <diffuse>0.06 0.34 0.48 1</diffuse>
        </material>
      </visual>
    </link>
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
  </model>
</sdf>
