<?xml version="1.0"?>
<sdf version="1.10">
  <world name="coral_reef_world">
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="libuuv_underwater_current_ros_plugin.so"
            name="uuv_simulator_ros::UnderwaterCurrentROSPlugin"/>
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>56.71897669633431</latitude_deg>
      <longitude_deg>3.515625</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.04 0.22 0.32 1</ambient>
      <background>0.01 0.05 0.08 1</background>
      <shadows>true</shadows>
      <fog>
        <type>linear</type>
        <color>0.02 0.20 0.28 1</color>
        <start>18</start>
        <end>95</end>
        <density>0.035</density>
      </fog>
    </scene>

    <light name="filtered_surface_light" type="directional">
      <pose>0 0 60 0.4 0.2 0</pose>
      <diffuse>0.35 0.62 0.72 1</diffuse>
      <specular>0.08 0.12 0.14 1</specular>
      <direction>-0.35 0.15 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="seabed">
      <static>true</static>
      <pose>0 0 -30 0 0 0</pose>
      <link name="seabed_link">
        <collision name="seabed_collision">
          <geometry>
            <box>
              <size>180 140 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="seabed_visual">
          <geometry>
            <box>
              <size>180 140 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.34 0.30 0.23 1</ambient>
            <diffuse>0.46 0.42 0.32 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="navigation_waypoints">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="waypoints_link">
        <visual name="wp_start">
          <pose>-35 -25 -24 0 0 0</pose>
          <geometry><sphere><radius>0.75</radius></sphere></geometry>
          <material><ambient>0 0.9 0.35 1</ambient><diffuse>0 0.9 0.35 1</diffuse></material>
        </visual>
        <visual name="wp_gap">
          <pose>-5 -5 -24 0 0 0</pose>
          <geometry><sphere><radius>0.75</radius></sphere></geometry>
          <material><ambient>1 0.9 0.1 1</ambient><diffuse>1 0.9 0.1 1</diffuse></material>
        </visual>
        <visual name="wp_goal">
          <pose>35 24 -24 0 0 0</pose>
          <geometry><sphere><radius>0.75</radius></sphere></geometry>
          <material><ambient>0.1 0.55 1 1</ambient><diffuse>0.1 0.55 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="uuv_simulator_demo_body">
      <pose>-20 -15 -24 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>120</mass>
          <inertia>
            <ixx>45</ixx>
            <iyy>125</iyy>
            <izz>125</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <pose>0 0 0 0 1.57079632679 0</pose>
          <geometry>
            <cylinder>
              <radius>0.65</radius>
              <length>4.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="body_visual">
          <pose>0 0 0 0 1.57079632679 0</pose>
          <geometry>
            <cylinder>
              <radius>0.65</radius>
              <length>4.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.72 0.08 1</ambient>
            <diffuse>1.0 0.82 0.16 1</diffuse>
            <specular>0.2 0.2 0.12 1</specular>
          </material>
        </visual>
        <visual name="nose_visual">
          <pose>2.55 0 0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.68</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.95 0.72 0.08 1</ambient>
            <diffuse>1.0 0.82 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="tail_fin_vertical">
          <pose>-2.2 -0.75 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 0.12 1.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.18 0.25 1</ambient>
            <diffuse>0.06 0.26 0.36 1</diffuse>
          </material>
        </visual>
        <visual name="tail_fin_horizontal">
          <pose>-2.2 0 0.75 0 0 0</pose>
          <geometry>
            <box>
              <size>1.1 0.12 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.18 0.25 1</ambient>
            <diffuse>0.06 0.26 0.36 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_linear>0.35 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
      </plugin>
    </model>

    <model name="reef_rocks_and_corals">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="reef_link">
        <collision name="rock_1_collision">
          <pose>-16 -8 -27.2 0.1 0.2 0.4</pose>
          <geometry><box><size>5 3 4</size></box></geometry>
        </collision>
        <visual name="rock_1_visual">
          <pose>-16 -8 -27.2 0.1 0.2 0.4</pose>
          <geometry><box><size>5 3 4</size></box></geometry>
          <material><ambient>0.20 0.18 0.16 1</ambient><diffuse>0.30 0.27 0.22 1</diffuse></material>
        </visual>

        <collision name="rock_2_collision">
          <pose>14 9 -27.0 -0.2 0.1 -0.25</pose>
          <geometry><box><size>6 4 4.5</size></box></geometry>
        </collision>
        <visual name="rock_2_visual">
          <pose>14 9 -27.0 -0.2 0.1 -0.25</pose>
          <geometry><box><size>6 4 4.5</size></box></geometry>
          <material><ambient>0.18 0.19 0.18 1</ambient><diffuse>0.28 0.30 0.28 1</diffuse></material>
        </visual>

        <collision name="coral_column_collision">
          <pose>0 -18 -25.8 0 0 0</pose>
          <geometry><cylinder><radius>1.2</radius><length>8</length></cylinder></geometry>
        </collision>
        <visual name="coral_column_visual">
          <pose>0 -18 -25.8 0 0 0</pose>
          <geometry><cylinder><radius>1.2</radius><length>8</length></cylinder></geometry>
          <material><ambient>0.86 0.28 0.20 1</ambient><diffuse>0.95 0.38 0.28 1</diffuse></material>
        </visual>

        <collision name="coral_head_collision">
          <pose>24 -18 -27.4 0 0 0</pose>
          <geometry><sphere><radius>2.6</radius></sphere></geometry>
        </collision>
        <visual name="coral_head_visual">
          <pose>24 -18 -27.4 0 0 0</pose>
          <geometry><sphere><radius>2.6</radius></sphere></geometry>
          <material><ambient>0.58 0.22 0.50 1</ambient><diffuse>0.78 0.32 0.66 1</diffuse></material>
        </visual>

        <collision name="gap_left_collision">
          <pose>-3 7 -26.5 0 0 0.35</pose>
          <geometry><box><size>2 8 5</size></box></geometry>
        </collision>
        <visual name="gap_left_visual">
          <pose>-3 7 -26.5 0 0 0.35</pose>
          <geometry><box><size>2 8 5</size></box></geometry>
          <material><ambient>0.12 0.36 0.30 1</ambient><diffuse>0.20 0.52 0.42 1</diffuse></material>
        </visual>

        <collision name="gap_right_collision">
          <pose>6 13 -26.5 0 0 0.35</pose>
          <geometry><box><size>2 8 5</size></box></geometry>
        </collision>
        <visual name="gap_right_visual">
          <pose>6 13 -26.5 0 0 0.35</pose>
          <geometry><box><size>2 8 5</size></box></geometry>
          <material><ambient>0.12 0.36 0.30 1</ambient><diffuse>0.20 0.52 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="reef_tunnel_marker">
      <static>true</static>
      <pose>-28 20 -26 0 0 0.7</pose>
      <link name="tunnel_link">
        <collision name="left_wall">
          <pose>-3 0 0 0 0 0</pose>
          <geometry><box><size>1.5 10 6</size></box></geometry>
        </collision>
        <collision name="right_wall">
          <pose>3 0 0 0 0 0</pose>
          <geometry><box><size>1.5 10 6</size></box></geometry>
        </collision>
        <collision name="roof">
          <pose>0 0 3 0 0 0</pose>
          <geometry><box><size>7 10 1.2</size></box></geometry>
        </collision>
        <visual name="left_wall_visual">
          <pose>-3 0 0 0 0 0</pose>
          <geometry><box><size>1.5 10 6</size></box></geometry>
          <material><ambient>0.18 0.16 0.13 1</ambient><diffuse>0.28 0.24 0.20 1</diffuse></material>
        </visual>
        <visual name="right_wall_visual">
          <pose>3 0 0 0 0 0</pose>
          <geometry><box><size>1.5 10 6</size></box></geometry>
          <material><ambient>0.18 0.16 0.13 1</ambient><diffuse>0.28 0.24 0.20 1</diffuse></material>
        </visual>
        <visual name="roof_visual">
          <pose>0 0 3 0 0 0</pose>
          <geometry><box><size>7 10 1.2</size></box></geometry>
          <material><ambient>0.18 0.16 0.13 1</ambient><diffuse>0.28 0.24 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
