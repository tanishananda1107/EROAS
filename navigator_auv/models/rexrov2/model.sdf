<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="rexrov2">

    <pose>0 0 -2 0 0 0</pose>

    <link name="base_link">

      <inertial>

        <mass>1862.87</mass>

        <inertia>
          <ixx>525.97</ixx>
          <iyy>794.08</iyy>
          <izz>691.23</izz>

          <ixy>1.44</ixy>
          <ixz>33.41</ixz>
          <iyz>2.6</iyz>
        </inertia>

      </inertial>

      <!-- MAIN BODY -->

      <collision name="body_collision">

        <geometry>
          <box>
            <size>2.6 1.5 1.0</size>
          </box>
        </geometry>

      </collision>

      <visual name="body_visual">

        <geometry>
          <box>
            <size>2.6 1.5 1.0</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.4 0.7 1</ambient>
          <diffuse>0.1 0.4 0.7 1</diffuse>
        </material>

      </visual>

      <!-- SONAR DOME -->

      <visual name="sonar_visual">

        <pose>1.3 0 0 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.9 0.9 0.0 1</ambient>
          <diffuse>0.9 0.9 0.0 1</diffuse>
        </material>

      </visual>

      <!-- GPU SONAR -->

      <sensor name="sonar" type="gpu_lidar">

        <pose>1.3 0 0 0 0 0</pose>

        <topic>/rexrov2/sonar_pointcloud</topic>

        <update_rate>10</update_rate>

        <lidar>

          <scan>

            <horizontal>

              <samples>64</samples>

              <resolution>1</resolution>

              <min_angle>-0.785</min_angle>

              <max_angle>0.785</max_angle>

            </horizontal>

            <vertical>

              <samples>32</samples>

              <resolution>1</resolution>

              <min_angle>-0.523</min_angle>

              <max_angle>0.523</max_angle>

            </vertical>

          </scan>

          <range>

            <min>0.5</min>

            <max>30.0</max>

            <resolution>0.01</resolution>

          </range>

        </lidar>

        <always_on>true</always_on>

        <visualize>true</visualize>

      </sensor>

      <!-- ODOMETRY -->

      <sensor name="odometry" type="odometry">

        <topic>/rexrov2/pose_gt</topic>

        <update_rate>50</update_rate>

        <always_on>true</always_on>

      </sensor>

    </link>

  </model>

</sdf>
